# ─────────────────────────────────────────────────────────────────────────────
# Nabhya API — copy to .env.local and fill in.
#
# Validated at boot by packages/env/src/server.ts. The server refuses to start
# if a required variable is missing, so a typo fails loudly rather than at the
# first request that needs it.
#
# Quickest path: `pnpm db:setup` runs an interactive Neon wizard that writes
# DATABASE_URL and DIRECT_URL for you.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────

# Pooled connection, used by the running app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (unpooled) connection. Drizzle Kit uses this for push/generate —
# migrations over a pooler are unreliable.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Allowed browser origin(s), comma-separated. Also used as the base URL when
# building certificate verification links, so put the public URL first.
CORS_ORIGIN="http://localhost:8081"

# development | production | test
# `production` additionally refuses to start with stubbed storage or payments.
NODE_ENV="development"

# Neon Auth. NEON_AUTH_URL is the project's auth base URL; the JWKS endpoint is
# what JwtGuard verifies incoming tokens against.
NEON_AUTH_URL="https://your-project.neon.tech/auth"
NEON_AUTH_JWKS_URL="https://your-project.neon.tech/auth/.well-known/jwks.json"


# ─── Object storage — Cloudflare R2 (optional) ───────────────────────────────
#
# Leave unset in development: the server falls back to an in-memory stub so
# every upload path stays exercisable, and logs a warning. Uploads are
# simulated and discarded, and a restart loses them.
#
# Required in production — verification documents that silently vanish are
# worse than a server that won't boot.

# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="nabhya-documents"

# Only needed if you serve some objects from a public bucket domain.
# Documents are always fetched through short-lived signed URLs instead.
# R2_PUBLIC_BASE_URL="https://files.yourdomain.com"


# ─── Payments — Dodo Payments (optional, currently on hold) ──────────────────
#
# Same pattern as storage: absent credentials fall back to a stub provider so
# the donation flow stays testable, and production refuses to start without
# real ones.
#
# Note: Dodo is product-based — `POST /payments` takes a product_cart, not a
# free-form amount. Variable donations are modelled as N units of a ₹1
# "donation" product, so amounts must be whole rupees. Create that product in
# the Dodo dashboard and put its id below.

# DODO_API_KEY="..."
# DODO_WEBHOOK_SECRET="whsec_..."
# DODO_DONATION_PRODUCT_ID="prod_..."
