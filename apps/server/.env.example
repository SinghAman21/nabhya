# ─────────────────────────────────────────────────────────────────────────────
# Nabhya API — copy to .env and fill in.
#
# Validated at boot by packages/env/src/server.ts. The server refuses to start
# if a required variable is missing, so a typo fails loudly rather than at the
# first request that needs it.
#
# Quickest path: `pnpm db:setup` runs an interactive Supabase wizard that
# writes DATABASE_URL and DIRECT_URL for you.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────

# Pooled connection (transaction-mode pgbouncer, port 6543), used by the
# running app.
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Direct (unpooled) connection, port 5432. Drizzle Kit uses this for
# push/generate — migrations over a pooler are unreliable.
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Allowed browser origin(s), comma-separated. Also used as the base URL when
# building certificate verification links, so put the public URL first.
CORS_ORIGIN="http://localhost:8081"

# development | production | test
# `production` additionally refuses to start with stubbed storage or payments.
NODE_ENV="development"

# Supabase Auth JWKS endpoint — what JwtGuard verifies incoming tokens
# against. Requires the project's JWT signing keys to be set to asymmetric
# (ES256/RS256) in Authentication settings; the legacy shared HS256 secret has
# no JWKS endpoint and isn't supported here.
SUPABASE_AUTH_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"


# ─── Object storage — Cloudflare R2 (optional) ───────────────────────────────
#
# Leave unset in development: the server falls back to an in-memory stub so
# every upload path stays exercisable, and logs a warning. Uploads are
# simulated and discarded, and a restart loses them.
#
# Required in production — verification documents that silently vanish are
# worse than a server that won't boot.

# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="nabhya-documents"

# Only needed if you serve some objects from a public bucket domain.
# Documents are always fetched through short-lived signed URLs instead.
# R2_PUBLIC_BASE_URL="https://files.yourdomain.com"


# ─── Payments — Razorpay (optional) ───────────────────────────────────────────
#
# Same pattern as storage: absent credentials fall back to a stub provider so
# the donation flow stays testable, and production refuses to start without
# real ones.
#
# RAZORPAY_KEY_ID is not secret — it is also handed to the native client to
# open the checkout sheet. RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are.

# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# RAZORPAY_WEBHOOK_SECRET="..."
