# ─────────────────────────────────────────────────────────────────────────────
# Nabhya app (Expo) - copy to .env.local and fill in.
#
# Only EXPO_PUBLIC_* variables reach the client bundle. Never put a secret
# here: anything with this prefix is embedded in the shipped app and readable
# by anyone who downloads it.
#
# Read by apps/native/src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Where the NestJS API lives.
#
# Optional in development - it falls back to 10.0.2.2:3000 on the Android
# emulator and localhost:3000 elsewhere. Required in production builds.
#
# A physical device cannot reach "localhost": use your machine's LAN IP, e.g.
# http://192.168.1.42:3000
EXPO_PUBLIC_API_URL="http://192.168.1.42:3000"

# Supabase project URL and anon (public) key. Both required - the app throws
# at import if either is unset, since nothing works without an auth provider.
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
