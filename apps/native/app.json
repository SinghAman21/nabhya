{
	"expo": {
		"name": "Nabhya",
		"slug": "nabhya",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "nabhya",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.nabhya.app",
			"icon": "./assets/expo.icon"
		},
		"android": {
			"package": "com.nabhya.app",
			"adaptiveIcon": {
				"backgroundColor": "#FFF3ED",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FF7E40",
					"android": {
						"image": "./assets/images/splash-icon.png",
						"imageWidth": 76
					}
				}
			],
			"expo-font",
			"expo-image",
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Nabhya uses your location to show nearby volunteer opportunities."
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Nabhya uses the camera so you can capture your government ID and a verification selfie.",
					"recordAudioAndroid": false
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Nabhya needs access to your photos so you can upload your government ID.",
					"cameraPermission": "Nabhya uses the camera so you can photograph your government ID."
				}
			],
			"expo-secure-store",
			"expo-status-bar",
			"expo-web-browser",
			"expo-video",
			"@react-native-community/datetimepicker"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
